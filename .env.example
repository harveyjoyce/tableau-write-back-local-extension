# ─────────────────────────────────────────────────────────────
# .env.example  —  copy this file to ".env" and fill in YOUR values
# Never commit the real .env to git!
# ─────────────────────────────────────────────────────────────

# Your Snowflake account identifier.
# Find it in: Snowflake UI → bottom-left account menu → "Copy account identifier"
# Examples:  xy12345.eu-west-1   or   myorg-myaccount
SF_ACCOUNT=your_account_identifier_here

# The Snowflake user you want to connect as
SF_USERNAME=your_snowflake_username

# That user's password
SF_PASSWORD=your_snowflake_password

# The DATABASE you want to read/write
SF_DATABASE=MY_DATABASE

# The SCHEMA inside that database (e.g. PUBLIC)
SF_SCHEMA=PUBLIC

# The virtual WAREHOUSE to use for queries
SF_WAREHOUSE=COMPUTE_WH

# (Optional) Role to use. Leave blank to use the user's default role.
SF_ROLE=

# Port the local server listens on (3000 is fine for local dev)
PORT=3000
